{
  // JSON5 spec: https://json5.org/
  // Renovate docs: https://docs.renovatebot.com/configuration-options/
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":enablePreCommit",
    ":gitSignOff",
  ],
  // Only rebase open PRs when they have merge conflicts, not on every
  // merge to main. The default "behind-base-branch" (from
  // config:recommended) causes a cascade of unnecessary rebases and
  // review-agent re-runs on busy days.
  "rebaseWhen": "conflicted",
  "dependencyDashboard": true,
  "platformAutomerge": true,
  // Keep the Skillsaw ruleset version in .skillsaw.yaml updateable.
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.skillsaw\\.yaml$/",
      ],
      "matchStrings": [
        "version:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?",
      ],
      "depNameTemplate": "skillsaw",
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440",
    },
    {
      // Track fullsend-ai/agents version pins in harness base: URLs.
      // SHA256 hashes are updated automatically by postUpgradeTasks
      // (scripts/renovate/update-fullsend-harness-sha.sh).
      "customType": "regex",
      "description": "Track fullsend-ai/agents version in harness base URLs",
      "managerFilePatterns": [".fullsend/harness/*.yaml"],
      "matchStrings": [
        "base:\\s*\"https://raw\\.githubusercontent\\.com/fullsend-ai/agents/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/",
      ],
      "depNameTemplate": "fullsend-ai/agents",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$",
    },
  ],
  // Give newly released dependencies time to receive initial security review.
  "minimumReleaseAge": "10 days",
  "lockFileMaintenance": {
    "enabled": true,
    // Lock file maintenance creates virtual entries without releaseTimestamp.
    // Inheriting the top-level minimumReleaseAge blocks these PRs indefinitely
    // under Renovate 42+'s default timestamp-required behaviour.
    "minimumReleaseAge": null,
  },
  "packageRules": [
    {
      // Use GitHub's native auto-merge only for patch and minor updates.
      "description": "Auto-merge patch and minor updates",
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
    },
    {
      // After fullsend-ai/agents version bump, recompute SHA256 hashes in
      // harness base: URLs.
      "description": "Update fullsend harness SHA256 hashes on version bump",
      "matchPackageNames": ["fullsend-ai/agents"],
      "postUpgradeTasks": {
        "commands": ["bash scripts/renovate/update-fullsend-harness-sha.sh"],
        "fileFilters": [".fullsend/harness/*.yaml"],
        // Per-update execution runs the hash updater for each agents upgrade,
        // including grouped branches regardless of branch-config ordering.
        "executionMode": "update",
      },
    },
    {
      // Group related Fullsend and agent updates without automerging them.
      "description": "Group Fullsend and agents updates",
      "matchPackageNames": [
        "fullsend-ai/fullsend",
        "fullsend-ai/agents",
      ],
      "groupName": "fullsend",
      "automerge": false,
    },
    {
      // Registries without release timestamps would otherwise leave Docker
      // updates pending indefinitely.
      "description": "Allow container updates without release timestamp",
      "matchDatasources": [
        "docker",
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional",
    },
    {
      // Red Hat registry images are trusted through the Red Hat image
      // delivery pipeline and do not need the generic stability wait.
      "description": "No stability wait for Red Hat base images",
      "matchPackageNames": [
        "registry.access.redhat.com/{/,}**",
        "registry.redhat.io/{/,}**",
      ],
      "minimumReleaseAge": null,
    },
    {
      // Pin pre-commit hook revisions to commit SHAs for supply-chain
      // integrity, consistent with docker:pinDigests and
      // helpers:pinGitHubActionDigests.
      "description": "Pin pre-commit hooks by commit SHA",
      "matchManagers": [
        "pre-commit",
      ],
      "pinDigests": true,
    },
    {
      // Renovate itself releases many times per day; the config-validator
      // hook doesn't need that cadence. Limit to one update per week to
      // avoid PR/CI churn from the renovate/pre-commit-hooks stream.
      "description": "Weekly-only updates for the Renovate pre-commit hook",
      "matchPackageNames": ["renovatebot/pre-commit-hooks"],
      "schedule": ["before 4am on Monday"],
      // When using schedule to throttle a package, also set
      // updateNotScheduled: false so already-open PRs are blocked
      // outside the window too. The default (true) otherwise keeps
      // pushing commits to open PRs regardless of schedule.
      "updateNotScheduled": false,
    },
    {
      // Keep the Skillsaw hook and its config version in sync.
      "description": "Group Skillsaw hook and config updates",
      "groupName": "skillsaw",
      "matchPackageNames": [
        "skillsaw",
        "stbenjam/skillsaw",
      ],
    },
    {
      // Runner images in scaffolded Fullsend workflows (for example the
      // `runs-on:` key and `runner_image:` inputs) must be bumped together
      // by Fullsend scaffold updates. Renovate only sees individual
      // `runs-on:` labels, so enabling runner updates here causes version
      // skew across the shim. ProtoBot's native workflows use
      // `ubuntu-latest`, so this leaves action and reusable-workflow
      // updates untouched.
      "description": "Disable GitHub runner image updates",
      "matchDatasources": ["github-runners"],
      "enabled": false,
    },
  ],
  // Security fixes should be proposed immediately.
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "0 days",
  },
}
