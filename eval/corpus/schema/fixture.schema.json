{
  "$id": "protobot://eval/corpus/schema/fixture/v1",
  "title": "ProtoBot evaluation corpus fixture",
  "description": "Version 1 fixture for requirements and Job Site evaluation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "corpus_revision",
    "archetype",
    "title",
    "project_description",
    "visible",
    "holdout",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "fixture_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "corpus_revision": {
      "type": "string",
      "minLength": 1
    },
    "archetype": {
      "$ref": "#/$defs/archetype"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "project_description": {
      "type": "string",
      "minLength": 1,
      "description": "Free-form description. This is the elicitation-input."
    },
    "visible": {
      "$ref": "#/$defs/visible_assets"
    },
    "holdout": {
      "$ref": "#/$defs/holdout_refs"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "archetype": {
      "type": "string",
      "enum": ["cli", "network-service", "web-gui"]
    },
    "interface_type": {
      "type": "string",
      "enum": [
        "network-service",
        "cli",
        "repl",
        "linkable-library",
        "web-gui",
        "native-gui",
        "persistent-state",
        "package-source"
      ]
    },
    "ears_type": {
      "type": "string",
      "enum": [
        "ubiquitous",
        "event-driven",
        "state-driven",
        "unwanted-behavior",
        "optional-feature",
        "complex"
      ]
    },
    "iso8601": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "sha256_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "requirement_id": {
      "type": "string",
      "pattern": "^REQ-[A-Z0-9]+-[0-9]{5}$"
    },
    "visible_assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vision",
        "architecture",
        "requirements",
        "interface_runtime",
        "reference_behavior_checks"
      ],
      "properties": {
        "vision": {
          "$ref": "#/$defs/vision"
        },
        "architecture": {
          "$ref": "#/$defs/architecture"
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "interface_runtime": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/interface_runtime"
          }
        },
        "reference_behavior_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/visible_check"
          }
        }
      }
    },
    "vision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "intended_users", "desired_outcomes"],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "intended_users": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "desired_outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_interfaces",
        "persistent_state",
        "environmental_constraints"
      ],
      "properties": {
        "external_interfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/external_interface"
          }
        },
        "persistent_state": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "environmental_constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "external_interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/interface_type"
        },
        "spec_approach": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "text",
        "applies_to",
        "verification",
        "provenance",
        "created"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/requirement_id"
        },
        "type": {
          "$ref": "#/$defs/ears_type"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "applies_to": {
          "$ref": "#/$defs/applies_to"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "provenance": {
          "type": "string",
          "enum": ["user-authored", "agent-suggested", "kit-imported"]
        },
        "created": {
          "$ref": "#/$defs/iso8601"
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship"
          }
        },
        "status": {
          "type": "string",
          "enum": ["active", "retired"]
        }
      }
    },
    "applies_to": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "anyOf": [
        {
          "required": ["interfaces"],
          "properties": {
            "interfaces": {
              "minItems": 1
            }
          }
        },
        {
          "required": ["scopes"],
          "properties": {
            "scopes": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["isolated-interface", "implementation-aware"]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "mode": {
            "const": "implementation-aware"
          }
        },
        "required": ["mode"]
      },
      "then": {
        "required": ["rationale"]
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "depends-on",
            "conflicts-with",
            "supersedes",
            "related-to"
          ]
        },
        "target": {
          "$ref": "#/$defs/requirement_id"
        }
      }
    },
    "interface_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface_id",
        "type",
        "runtime",
        "credentials",
        "hosted_cluster"
      ],
      "properties": {
        "interface_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/interface_type"
        },
        "runtime": {
          "type": "string",
          "enum": ["local-process", "local-http", "local-web"]
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "credentials": {
          "type": "string",
          "enum": ["none"]
        },
        "hosted_cluster": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "visible_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "visibility",
        "requirement_ids",
        "interface_id",
        "description",
        "setup",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^VIS-[A-Z0-9]+-[0-9]{5}$"
        },
        "visibility": {
          "type": "string",
          "const": "worker-visible"
        },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requirement_id"
          }
        },
        "interface_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "setup": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "holdout_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assets"],
      "properties": {
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/holdout_asset_ref"
          }
        }
      }
    },
    "holdout_asset_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "path",
        "digest",
        "requirement_ids",
        "interface_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^HO-[A-Z0-9]+-[0-9]{5}$"
        },
        "kind": {
          "type": "string",
          "const": "behavior-check"
        },
        "path": {
          "type": "string",
          "pattern": "^holdout/[A-Za-z0-9._-]+$"
        },
        "digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requirement_id"
          }
        },
        "interface_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "authors",
        "reviewers",
        "rationale",
        "known_ambiguities"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["illustrative", "reviewed"]
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reviewers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reviewed_at": {
          "$ref": "#/$defs/iso8601"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "known_ambiguities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
