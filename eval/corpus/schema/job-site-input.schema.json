{
  "$id": "protobot://eval/corpus/schema/job-site-input/v1",
  "title": "ProtoBot Job Site Worker-visible projection",
  "description": "Worker-visible Job Site input. Holdout assets and the elicitation project description are absent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "corpus_revision",
    "archetype",
    "title",
    "visible"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "fixture_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "corpus_revision": {
      "type": "string",
      "minLength": 1
    },
    "archetype": {
      "type": "string",
      "enum": [
        "cli",
        "network-service",
        "web-gui"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "visible": {
      "$ref": "#/$defs/visible_assets"
    }
  },
  "allOf": [
    {
      "not": {
        "required": [
          "holdout"
        ]
      }
    },
    {
      "not": {
        "required": [
          "project_description"
        ]
      }
    }
  ],
  "$defs": {
    "visible_assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vision",
        "architecture",
        "requirements",
        "interface_runtime",
        "reference_behavior_checks"
      ],
      "properties": {
        "vision": {
          "$ref": "#/$defs/vision"
        },
        "architecture": {
          "$ref": "#/$defs/architecture"
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "interface_runtime": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/interface_runtime"
          }
        },
        "reference_behavior_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/visible_check"
          }
        }
      }
    },
    "vision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "intended_users",
        "desired_outcomes"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "intended_users": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "desired_outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_interfaces",
        "persistent_state",
        "environmental_constraints"
      ],
      "properties": {
        "external_interfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/external_interface"
          }
        },
        "persistent_state": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "environmental_constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "external_interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/interface_type"
        },
        "spec_approach": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "interface_type": {
      "type": "string",
      "enum": [
        "network-service",
        "cli",
        "repl",
        "linkable-library",
        "web-gui",
        "native-gui",
        "persistent-state",
        "package-source"
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "text",
        "applies_to",
        "verification",
        "provenance",
        "created"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/requirement_id"
        },
        "type": {
          "$ref": "#/$defs/ears_type"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "applies_to": {
          "$ref": "#/$defs/applies_to"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "provenance": {
          "type": "string",
          "enum": [
            "user-authored",
            "agent-suggested",
            "kit-imported"
          ]
        },
        "created": {
          "$ref": "#/$defs/iso8601"
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "retired"
          ]
        }
      }
    },
    "requirement_id": {
      "type": "string",
      "pattern": "^REQ-[A-Z0-9]+-[0-9]{5}$"
    },
    "ears_type": {
      "type": "string",
      "enum": [
        "ubiquitous",
        "event-driven",
        "state-driven",
        "unwanted-behavior",
        "optional-feature",
        "complex"
      ]
    },
    "applies_to": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "interfaces"
          ],
          "properties": {
            "interfaces": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "scopes"
          ],
          "properties": {
            "scopes": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "isolated-interface",
            "implementation-aware"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "mode": {
            "const": "implementation-aware"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "required": [
          "rationale"
        ]
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "target"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "depends-on",
            "conflicts-with",
            "supersedes",
            "related-to"
          ]
        },
        "target": {
          "$ref": "#/$defs/requirement_id"
        }
      }
    },
    "interface_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface_id",
        "type",
        "runtime",
        "credentials",
        "hosted_cluster"
      ],
      "properties": {
        "interface_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/interface_type"
        },
        "runtime": {
          "type": "string",
          "enum": [
            "local-process",
            "local-http",
            "local-web"
          ]
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "credentials": {
          "type": "string",
          "enum": [
            "none"
          ]
        },
        "hosted_cluster": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "visible_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "visibility",
        "requirement_ids",
        "interface_id",
        "description",
        "setup",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^VIS-[A-Z0-9]+-[0-9]{5}$"
        },
        "visibility": {
          "type": "string",
          "const": "worker-visible"
        },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requirement_id"
          }
        },
        "interface_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "setup": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "iso8601": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
