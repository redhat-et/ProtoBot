{
  "$id": "protobot://eval/corpus/schema/holdout-asset/v1",
  "title": "ProtoBot evaluation corpus holdout asset",
  "description": "Evaluator-only behavior checks. Never mounted into a Worker view.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "checks"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "fixture_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "visibility",
          "requirement_ids",
          "interface_id",
          "description",
          "setup",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^HO-[A-Z0-9]+-[0-9]{5}$"
          },
          "visibility": {
            "type": "string",
            "const": "evaluator-only"
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^REQ-[A-Z0-9]+-[0-9]{5}$"
            }
          },
          "interface_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "setup": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": true
          }
        }
      }
    }
  }
}
