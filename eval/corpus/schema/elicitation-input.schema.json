{
  "$id": "protobot://eval/corpus/schema/elicitation-input/v1",
  "title": "ProtoBot elicitation-input projection",
  "description": "Generator-visible input for requirements evaluation. Golden artifacts and holdouts are absent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "corpus_revision",
    "archetype",
    "title",
    "project_description"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "fixture_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "corpus_revision": {
      "type": "string",
      "minLength": 1
    },
    "archetype": {
      "type": "string",
      "enum": ["cli", "network-service", "web-gui"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "project_description": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "not": {
        "required": ["visible"]
      }
    },
    {
      "not": {
        "required": ["holdout"]
      }
    },
    {
      "not": {
        "required": ["provenance"]
      }
    }
  ]
}
